# ---------------------------------------------------------------------------
# Mandate environment variables
# Copy to `.env.local` and fill in only what you need.
# The app runs fully in Demo Mode with NO variables set.
# ---------------------------------------------------------------------------

# Public site URL (used for share/metadata). Optional.
NEXT_PUBLIC_SITE_URL=

# --- Optional: live market-data snapshot from Binance public API ---
# The research feed tries Binance's public, keyless endpoints
# (/api/v3/ticker/price, /api/v3/ticker/24hr) for BTC/ETH. If the request
# fails (region block, offline), the app falls back to clearly-labelled
# cached quotes. There is nothing secret here — but you can point at a
# regional mirror if you have one.
AGENTGUARD_MARKET_BASE_URL=https://api.binance.com

# --- Live Agent OS wiring (NOT used by the deployed demo) ---
# Mandate is a policy layer that sits in front of an agent connected to
# Binance Agent OS (Binance MCP Server, connected from your own desktop MCP
# client, authenticated to your own Agentic sub-account). The web app never
# holds your Binance credentials. See README "Live Mode" for the reference
# wiring script that runs the PolicyEngine guard against your local MCP agent.
# No secrets belong in this repo.
